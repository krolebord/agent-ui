{
  "name": "agent-ui",
  "version": "0.28.0",
  "private": true,
  "author": "krolebord",
  "description": "Simple orchestrator for CLI agents",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:static": "vite build --sourcemap && electron .",
    "build": "tsc --noEmit && vite build",
    "build:headless": "pnpm typecheck && tsc -p tsconfig.headless.json --noEmit && vite build --config vite.renderer.config.ts && vite build --config vite.headless.config.ts",
    "start:headless": "node dist-headless/index.js",
    "promote:headless": "bash scripts/promote-headless-release.sh",
    "analyze": "ANALYZE=true vite build",
    "app:dist": "pnpm build && electron-builder",
    "app:dist:mac": "pnpm build && electron-builder --mac",
    "app:dist:mac:dir": "pnpm build && electron-builder --mac dir",
    "app:install": "pnpm app:dist:mac:dir && ./scripts/install-mac-app.sh",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:headless": "pnpm build:headless && node test/headless/smoke.mjs",
    "extract-cursor-models": "bash scripts/extract-cursor-models.sh",
    "extract-codex-models": "bash scripts/extract-codex-models.sh"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "^1.14.14",
    "@orpc/server": "^1.14.14",
    "@orpc/tanstack-query": "^1.14.14",
    "@pierre/diffs": "^1.3.4",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "conf": "^15.1.0",
    "croner": "^10.0.1",
    "electron-log": "^5.4.4",
    "fix-path": "^5.0.0",
    "immer": "^11.1.16",
    "jsonc-parser": "^3.3.1",
    "kysely": "^0.29.4",
    "lucide-react": "^1.29.0",
    "nano-spawn": "^2.1.0",
    "node-pty": "1.2.0-beta.11",
    "partysocket": "^1.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "systeminformation": "^5.33.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "macos-temperature-sensor": "^1.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "lefthook",
      "macos-temperature-sensor",
      "node-pty"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.3",
    "lefthook": "^2.1.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.0"
  }
}
